# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=3000

# MongoDB connection string: local server or MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/promptvault

# Address of a browser front end allowed to call the API (CORS). Not needed for Postman.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens: a random string of at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login token stays valid. Include a unit: 30m, 2h, 1d
JWT_EXPIRES_IN=2h

# Password for the demo accounts created by "npm run seed:demo" (8 to 72 characters).
# Only needed when you run that script.
DEMO_PASSWORD=
