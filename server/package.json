{
  "name": "promptvault-server",
  "version": "1.0.0",
  "description": "PromptVault REST API built with Express and MongoDB",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-categories.js",
    "seed:demo": "node scripts/seed-categories.js && node scripts/seed-demo.js",
    "make-admin": "node scripts/make-admin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  }
}
