    {
      "name": "3. Admin",
      "description": "Needs adminEmail and adminPassword. npm run seed:demo creates admin.demo@example.com with DEMO_PASSWORD.",
      "item": [
        {
          "name": "Admin logs in",
          "request": {
            "method": "POST",
