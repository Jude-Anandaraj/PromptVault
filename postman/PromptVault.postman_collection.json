              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const names = pm.response.json().categories;",
                  "pm.test(\"At least one category (run npm run seed if this fails)\", () => pm.expect(names.length).to.be.above(0));",
                  "pm.collectionVariables.set(\"categoryName\", names[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a prompt without logging in (401)",
          "request": {
