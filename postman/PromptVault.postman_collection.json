            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"No token\",\n  \"description\": \"This should be refused.\",\n  \"content\": \"This request has no token.\",\n  \"category\": \"{{categoryName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
