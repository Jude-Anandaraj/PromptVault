            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test prompt\",\n  \"description\": \"Created by the Postman collection.\",\n  \"content\": \"Explain [topic] in three short steps for a beginner.\",\n  \"category\": \"{{categoryName}}\",\n  \"tags\": [\n    \"postman\",\n    \"test\"\n  ]\n}",
